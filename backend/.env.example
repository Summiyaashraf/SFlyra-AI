# Provider fallback chain: Grok -> OpenRouter -> Gemini -> OpenAI (optional).
# The backend tries them in this order and silently falls through on failure.
# Configure AT LEAST ONE; add as many as you like.

# 1) Grok (xAI) — tries this first
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4-latest

# 2) OpenRouter — used if Grok fails or has no key
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# 3) Gemini (Google) — used if OpenRouter fails or has no key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 4) OpenAI (optional) — final fallback
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000